# Node.js Application Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_256bit_secret_key_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5433/arc_fl_db?schema=public"

# Python FastAPI Machine Learning Service
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_API_KEY="replace_with_a_secure_random_api_key_in_production"

# Relative or absolute path to model storage root
STORAGE_ROOT="../storage"
