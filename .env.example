# ==============================================================================
# ARC-FL Monorepo Environment Configuration (.env.example)
# ==============================================================================

# Node.js Application Backend (Port 5000)
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_256bit_secret_key_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Prisma ORM)
# Default port 5433 (or standard 5432 if your PostgreSQL runs on 5432)
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5433/arc_fl_db?schema=public"

# Python FastAPI Machine Learning Service (Port 8000)
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_API_KEY="replace_with_a_secure_random_api_key_in_production"

# Model and Dataset Storage Directory (Relative or Absolute Path)
STORAGE_ROOT="./storage"

# Validation Dataset Path (CICIoT2023 45-feature format)
VALIDATION_DATASET_PATH="./storage/datasets/validation.csv"
INITIAL_MODEL_DIR="./storage/global-models/initial-v1"

# Frontend Vite Development (Port 5173)
VITE_API_URL="http://localhost:5000/api"
